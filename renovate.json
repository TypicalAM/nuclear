{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub release binaries in install-extra-packages; bumps the tag and its pinned checksum together",
      "managerFilePatterns": ["/^build-ctx/install-extra-packages$/"],
      "matchStrings": [
        "# renovate: repo=(?<depName>\\S+)\\n[A-Z_]+_TAG=\"(?<currentValue>[^\"]+)\"\\n(?:.*\\n)*?echo \"(?<currentDigest>[a-f0-9]+) "
      ],
      "datasourceTemplate": "github-release-attachments"
    }
  ]
}
