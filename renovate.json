{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "GitHub release binaries in install-extra-packages; bumps the tag and its pinned checksum together",
      "managerFilePatterns": [
        "/^build-ctx/install-extra-packages$/"
      ],
      "matchStrings": [
        "# renovate: repo=(?<depName>\\S+)\\n[A-Z_]+_TAG=\"(?<currentValue>[^\"]+)\"\\n(?:.*\\n)*?echo \"(?<currentDigest>[a-f0-9]+) "
      ],
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "gpu-unlock commit pinned in build-gpu-unlock; it has no release tags, so follow main",
      "managerFilePatterns": [
        "/^build-ctx/build-gpu-unlock$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\nGPU_UNLOCK_REV=(?<currentDigest>[a-f0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Sunshine AppImage in install-sunshine; bumps the version and its pinned checksum together",
      "managerFilePatterns": [
        "/^build-ctx/install-sunshine$/"
      ],
      "matchStrings": [
        "SUNSHINE_VERSION=\"(?<currentValue>[^\"]+)\"\\nSUNSHINE_FILE=\"[^\"]+\"\\nSUNSHINE_SHA256=\"(?<currentDigest>[a-f0-9]+)\""
      ],
      "depNameTemplate": "LizardByte/Sunshine",
      "datasourceTemplate": "github-release-attachments",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "ublue-os/container-storage-action has no releases or tags, so follow main",
      "managerFilePatterns": [
        "/^\\.github/workflows/container-image\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\n\\s+uses: \\S+@(?<currentDigest>[a-f0-9]{40})"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Handled by the custom manager above (tracks main)",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "ublue-os/container-storage-action"
      ],
      "enabled": false
    }
  ]
}
